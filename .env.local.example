# Vercel Blob storage — created automatically when you connect a Blob
# store to this project in the Vercel dashboard (Storage tab). Locally,
# run `vercel env pull .env.local` after connecting it, or paste the
# token here.
BLOB_READ_WRITE_TOKEN=

# Shared passcode teachers use to access /upload. Pick any string.
# This is a stopgap until real teacher login is built — not real auth.
UPLOAD_PASSCODE=
