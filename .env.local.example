# Vercel Blob storage — created automatically when you connect a Blob
# store to this project in the Vercel dashboard (Storage tab). Locally,
# run `vercel env pull .env.local` after connecting it, or paste the
# token here.
BLOB_READ_WRITE_TOKEN=

# Shared passcode teachers use to access /upload and /review. Pick any
# string. This is a stopgap until real teacher login is built — not
# real auth.
UPLOAD_PASSCODE=

# Postgres connection string for material metadata (titles,
# descriptions, review status). Vercel dashboard → Storage → connect a
# Neon Postgres database to this project — it sets this automatically.
# Locally, run `vercel env pull .env.local` after connecting, or copy
# the connection string manually.
DATABASE_URL=

# Anthropic API key, powers the Japji Sahib assistant inside the
# search widget (questions about Japji Sahib, Jap Ji, Mool Mantar, or
# a specific pauri). Get one at https://console.anthropic.com/ —
# Settings → API Keys. Without this, the widget's regular materials
# search still works fine; Japji questions just get a message saying
# the assistant isn't configured yet.
#
# This endpoint is public and unauthenticated (kids using the site hit
# it directly), so before setting this, set a monthly spend limit on
# the key's org/workspace in the Anthropic Console (Settings → Limits)
# — that's the actual hard cap on cost. The app also rate-limits each
# visitor on its own (see src/lib/japji-rate-limit.ts), but that's a
# courtesy layer on top of the spend limit, not a substitute for it.
ANTHROPIC_API_KEY=

# Which Claude model answers Japji Sahib questions. Optional — defaults
# to Haiku (cheap, and this task is mostly faithful reading/attribution
# of text handed to it via a tool, which smaller models do well). Set
# to e.g. "claude-sonnet-5" if answers start skipping steps (not
# checking coverage-status.md, guessing instead of reading a file) or
# paraphrasing too loosely.
JAPJI_CHAT_MODEL=
